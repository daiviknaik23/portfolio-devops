pipeline {
    agent any

    environment {
        AWS_DEFAULT_REGION = 'ap-south-1'
        S3_BUCKET = 'daivik-portfolio-website'
        CLOUDFRONT_DISTRIBUTION_ID = 'EXXXXXXXXXX'
        NODE_VERSION = '18'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                echo '📥 Checking out source code...'
                checkout scm
                sh 'git log --oneline -5'
            }
        }

        stage('Setup Node.js') {
            steps {
                echo '⚙️ Setting up Node.js...'
                sh '''
                    export NVM_DIR="$HOME/.nvm"
                    [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
                    nvm use ${NODE_VERSION} || nvm install ${NODE_VERSION}
                    node --version
                    npm --version
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                echo '📦 Installing dependencies...'
                sh 'npm ci --prefer-offline'
            }
        }

        stage('Lint') {
            steps {
                echo '🔍 Running linter...'
                sh 'npm run lint || true'
            }
        }

        stage('Build') {
            steps {
                echo '🔨 Building Vite application...'
                sh 'npm run build'
                sh 'ls -la dist/'
            }
        }

        stage('Deploy to S3') {
            steps {
                echo '☁️ Deploying to AWS S3...'
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credentials',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']]) {
                    sh '''
                        aws s3 sync dist/ s3://${S3_BUCKET}/ \
                            --delete \
                            --cache-control "public, max-age=31536000" \
                            --exclude "index.html" \
                            --exclude "*.json"

                        aws s3 cp dist/index.html s3://${S3_BUCKET}/index.html \
                            --cache-control "public, max-age=0, must-revalidate"

                        aws s3 cp dist/manifest.json s3://${S3_BUCKET}/manifest.json \
                            --cache-control "public, max-age=0, must-revalidate" \
                            || true
                    '''
                }
            }
        }

        stage('Invalidate CloudFront Cache') {
            steps {
                echo '⚡ Invalidating CloudFront cache...'
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credentials',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']]) {
                    sh '''
                        aws cloudfront create-invalidation \
                            --distribution-id ${CLOUDFRONT_DISTRIBUTION_ID} \
                            --paths "/*"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo '✅ Deployment successful!'
            echo "🌐 Website: https://daivik-portfolio.example.com"
        }
        failure {
            echo '❌ Deployment failed!'
        }
        always {
            echo '🧹 Cleaning up workspace...'
            cleanWs()
        }
    }
}
